generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  REVOKED
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum IssueTypeKind {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum ProjectTemplate {
  KANBAN
  SCRUM
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ReleaseStatus {
  PLANNED
  RELEASED
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  ISSUE_UPDATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SINGLE_SELECT
  MULTI_SELECT
  USER
  URL
}
enum AutomationJobStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}
enum BulkOperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}
enum BulkOperationItemStatus {
  PENDING
  SUCCEEDED
  FAILED
}
enum ChatProvider {
  SLACK
  TEAMS
}
enum DevelopmentProvider {
  GITHUB
  GITLAB
}
enum DevelopmentActivityKind {
  BRANCH
  COMMIT
  PULL_REQUEST
  MERGE_REQUEST
  BUILD
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  passwordHash   String?
  avatarUrl      String?
  timezone       String            @default("UTC")
  emailNotifications Boolean       @default(true)
  inAppNotifications Boolean       @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  memberships    WorkspaceMember[]
  projectRoles   ProjectMember[]
  reportedIssues Issue[]           @relation("Reporter")
  assignedIssues Issue[]           @relation("Assignee")
  comments       Comment[]
  activities     IssueActivity[]
  notifications  Notification[]  @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
  watchedIssues   IssueWatcher[]
  savedFilters    SavedFilter[]
  recentIssueViews RecentIssueView[]
  sessions       Session[]
  passwordResetTokens PasswordResetToken[]
  ledProjects    Project[]         @relation("ProjectLead")
  defaultProjects Project[]        @relation("ProjectDefaultAssignee")
  emailDeliveries EmailDelivery[]
  apiTokens ApiToken[]
  workspacePreferences UserWorkspacePreference[]
  organizationMemberships OrganizationMember[]
  samlIdentities SamlIdentity[]
  scimIdentities ScimIdentity[]
  scimTokensCreated ScimToken[]
}

model Workspace {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  memberships   WorkspaceMember[]
  projects      Project[]
  labels        Label[]
  notifications Notification[]
  recentViews RecentIssueView[]
  auditEvents   AuditEvent[]
  invitations   WorkspaceInvitation[]
  savedFilters  SavedFilter[]
  emailDeliveries EmailDelivery[]
  issueHistory IssueHistory[]
  apiTokens ApiToken[]
  webhookSubscriptions WebhookSubscription[]
  customFields CustomField[]
  automationRules AutomationRule[]
  automationJobs AutomationJob[]
  automationExecutions AutomationExecution[]
  developmentConnections DevelopmentConnection[]
  developmentDeliveries DevelopmentWebhookDelivery[]
  realtimeEvents RealtimeEvent[]
  bulkOperations BulkOperation[]
  chatConnections ChatConnection[]
  userPreferences UserWorkspacePreference[]
  permissionSchemes PermissionScheme[]
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  allowedDomains String[]
  allowAccountLinking Boolean @default(false)
  restrictInvitations Boolean @default(false)
  enforceSso Boolean @default(false)
  allowLocalLogin Boolean @default(true)
  allowJitProvisioning Boolean @default(false)
  sessionLifetimeMinutes Int @default(10080)
  privilegedReauthMinutes Int @default(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspaces Workspace[]
  members OrganizationMember[]
  domains OrganizationDomain[]
  samlConfiguration SamlConfiguration?
  samlIdentities SamlIdentity[]
  samlRequests SamlRequest[]
  samlAssertions SamlAssertionReplay[]
  scimTokens ScimToken[]
  scimIdentities ScimIdentity[]
  groups OrganizationGroup[]
  scimLogs ScimProvisioningLog[]

  @@index([slug])
}

model ScimToken {
  id String @id @default(cuid())
  organizationId String
  createdById String
  name String
  prefix String @unique
  secretHash String @unique
  scopes String[]
  expiresAt DateTime?
  lastUsedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, revokedAt, createdAt])
}

model ScimIdentity {
  id String @id @default(cuid())
  organizationId String
  userId String
  externalId String?
  userName String
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  groupMemberships OrganizationGroupMember[]

  @@unique([organizationId, userId])
  @@unique([organizationId, userName])
  @@unique([organizationId, externalId])
  @@index([userId])
}

model OrganizationGroup {
  id String @id @default(cuid())
  organizationId String
  externalId String?
  displayName String
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members OrganizationGroupMember[]
  mappings ScimGroupMapping[]

  @@unique([organizationId, displayName])
  @@unique([organizationId, externalId])
  @@index([organizationId, updatedAt])
}

model OrganizationGroupMember {
  groupId String
  scimIdentityId String
  createdAt DateTime @default(now())
  group OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scimIdentity ScimIdentity @relation(fields: [scimIdentityId], references: [id], onDelete: Cascade)

  @@id([groupId, scimIdentityId])
  @@index([scimIdentityId])
}

model ScimGroupMapping {
  id String @id @default(cuid())
  groupId String
  workspaceId String
  projectId String?
  role String
  createdAt DateTime @default(now())
  group OrganizationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, workspaceId, projectId, role])
  @@index([workspaceId, projectId])
}

model ScimProvisioningLog {
  id BigInt @id @default(autoincrement())
  organizationId String
  tokenId String?
  action String
  resourceType String
  resourceId String?
  status Int
  errorCode String?
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model SamlConfiguration {
  id String @id @default(cuid())
  organizationId String @unique
  entityId String
  entryPoint String
  idpIssuer String
  idpCertificates String[]
  encryptedSpPrivateKey String?
  spCertificate String?
  encryptedDecryptionPrivateKey String?
  decryptionCertificate String?
  allowIdpInitiated Boolean @default(false)
  attributeMapping Json
  enabled Boolean @default(false)
  testedAt DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SamlIdentity {
  id String @id @default(cuid())
  organizationId String
  userId String
  issuer String
  nameId String
  nameIdFormat String?
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@unique([organizationId, issuer, nameId])
  @@index([userId])
}

model SamlRequest {
  id String @id @default(cuid())
  organizationId String
  requestId String @unique
  relayPath String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

model SamlAssertionReplay {
  assertionId String @id
  organizationId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
}

model OrganizationMember {
  organizationId String
  userId String
  role OrganizationRole @default(MEMBER)
  breakGlass Boolean @default(false)
  recoveryConfirmedAt DateTime?
  joinedAt DateTime @default(now())
  deactivatedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId, deactivatedAt])
}

model OrganizationDomain {
  id String @id @default(cuid())
  organizationId String
  domain String @unique
  status DomainVerificationStatus @default(PENDING)
  challengeHash String
  challengeExpiresAt DateTime
  verifiedAt DateTime?
  verifiedChallengeHash String?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([challengeExpiresAt])
}

model UserWorkspacePreference {
  userId String
  workspaceId String
  theme String @default("SYSTEM")
  dashboardVersion Int @default(1)
  dashboardLayout Json
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@id([userId, workspaceId])
  @@index([workspaceId])
}

model ChatConnection {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  provider ChatProvider
  name String
  channelName String
  encryptedEndpoint String
  endpointFingerprint String
  events String[]
  detailLevel String @default("STANDARD")
  enabled Boolean @default(true)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  deliveries ChatDelivery[]
  @@index([workspaceId, enabled])
  @@index([projectId])
}

model ChatDelivery {
  id String @id @default(cuid())
  connectionId String
  eventId String
  event String
  payload Json
  status WebhookDeliveryStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  deliveredAt DateTime?
  responseStatus Int?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  connection ChatConnection @relation(fields:[connectionId], references:[id], onDelete:Cascade)
  @@unique([connectionId, eventId])
  @@index([status, availableAt])
  @@index([connectionId, createdAt])
}

model BulkOperation {
  id String @id @default(cuid())
  workspaceId String
  actorId String
  idempotencyKey String
  querySnapshot Json
  changes Json
  status BulkOperationStatus @default(PENDING)
  total Int
  succeeded Int @default(0)
  failed Int @default(0)
  cancelRequestedAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  items BulkOperationItem[]
  @@unique([workspaceId, actorId, idempotencyKey])
  @@index([status, createdAt])
}

model BulkOperationItem {
  id String @id @default(cuid())
  operationId String
  issueId String
  expectedVersion Int
  status BulkOperationItemStatus @default(PENDING)
  error String?
  completedAt DateTime?
  operation BulkOperation @relation(fields:[operationId], references:[id], onDelete:Cascade)
  @@unique([operationId, issueId])
  @@index([operationId, status])
}

model RealtimeEvent {
  id BigInt @id @default(autoincrement())
  workspaceId String
  projectId String?
  type String
  resourceId String?
  payload Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@index([workspaceId, id])
  @@index([createdAt])
}

model WorkspaceInvitation {
  id            String           @id @default(cuid())
  workspaceId   String
  projectId     String?
  email         String
  workspaceRole WorkspaceRole    @default(MEMBER)
  projectRole   ProjectRole      @default(MEMBER)
  status        InvitationStatus @default(PENDING)
  tokenHash     String           @unique
  invitedById   String
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  deactivatedAt DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id            String                @id @default(cuid())
  workspaceId   String
  name          String
  key           String
  description   String?
  visibility    ProjectVisibility     @default(PUBLIC)
  template      ProjectTemplate       @default(KANBAN)
  issueSequence Int                   @default(0)
  archivedAt    DateTime?
  leadId        String?
  defaultAssigneeId String?
  defaultPriority Priority             @default(MEDIUM)
  permissionSchemeVersionId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  issueTypes    IssueType[]
  statuses      Status[]
  issues        Issue[]
  boards        Board[]
  sprints       Sprint[]
  invitations   WorkspaceInvitation[]
  workflowTransitions WorkflowTransition[]
  workflowVersions WorkflowVersion[]
  issueImports IssueImport[]
  importedIssues ImportedIssue[]
  issueHistory IssueHistory[]
  releases Release[]
  webhookSubscriptions WebhookSubscription[]
  customFieldConfigurations CustomFieldProject[]
  customFieldValues CustomFieldValue[]
  automationRules AutomationRule[]
  lead          User?                 @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  defaultAssignee User?               @relation("ProjectDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  permissionSchemeVersion PermissionSchemeVersion? @relation(fields: [permissionSchemeVersionId], references: [id], onDelete: Restrict)
  securityLevels IssueSecurityLevel[]

  @@unique([workspaceId, key])
  @@index([workspaceId, archivedAt])
  @@index([leadId])
  @@index([defaultAssigneeId])
  @@index([permissionSchemeVersionId])
}

model PermissionScheme {
  id String @id @default(cuid())
  workspaceId String
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions PermissionSchemeVersion[]

  @@unique([workspaceId, name])
}

model PermissionSchemeVersion {
  id String @id @default(cuid())
  schemeId String
  version Int
  permissions Json
  createdById String
  createdAt DateTime @default(now())
  scheme PermissionScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([schemeId, version])
}

model IssueSecurityLevel {
  id String @id @default(cuid())
  projectId String
  name String
  description String?
  grants Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues Issue[]

  @@unique([projectId, name])
}

model AutomationRule {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  name String
  trigger Json
  conditions Json
  actions Json
  permissions String[]
  enabled Boolean @default(true)
  createdById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs AutomationJob[]
  executions AutomationExecution[]
  @@index([workspaceId, projectId, enabled])
}
model AutomationJob {
  id String @id @default(cuid())
  workspaceId String
  ruleId String
  eventId String
  event String
  payload Json
  correlationId String
  depth Int @default(0)
  status AutomationJobStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@unique([ruleId, eventId])
  @@index([status, availableAt])
}
model AutomationExecution {
  id String @id @default(cuid())
  workspaceId String
  ruleId String
  jobId String @unique
  correlationId String
  input Json
  result Json
  durationMs Int
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([ruleId, createdAt])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model IssueType {
  id        String        @id @default(cuid())
  projectId String
  name      String
  kind      IssueTypeKind
  icon      String?
  position  Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([projectId, name])
}

model Status {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory
  color     String
  position  Int
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  columns   BoardColumn[]
  outgoingTransitions WorkflowTransition[] @relation("TransitionFrom")
  incomingTransitions WorkflowTransition[] @relation("TransitionTo")

  @@unique([projectId, name])
}

model WorkflowTransition {
  id        String @id @default(cuid())
  projectId String
  fromStatusId String
  toStatusId String
  name String @default("Transition")
  description String?
  position Int @default(0)
  enabled Boolean @default(true)
  conditions Json?
  validators Json?
  actions Json?
  workflowVersion Int @default(1)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus Status @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   Status @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromStatusId, toStatusId])
  @@index([fromStatusId])
  @@index([toStatusId])
}

model WorkflowVersion {
  id String @id @default(cuid())
  projectId String
  version Int
  configuration Json
  createdById String
  publishedAt DateTime @default(now())
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, publishedAt])
}

model Issue {
  id           String          @id @default(cuid())
  workspaceId  String
  projectId    String
  number       Int
  issueTypeId  String
  statusId     String
  reporterId   String
  assigneeId   String?
  parentId     String?
  summary      String
  description  Json?
  resolution   String?
  priority     Priority        @default(MEDIUM)
  estimate     Int?
  rank         String
  dueDate      DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  version      Int             @default(1)
  securityLevelId String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueType    IssueType       @relation(fields: [issueTypeId], references: [id])
  status       Status          @relation(fields: [statusId], references: [id])
  reporter     User            @relation("Reporter", fields: [reporterId], references: [id])
  assignee     User?           @relation("Assignee", fields: [assigneeId], references: [id])
  parent       Issue?          @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Issue[]         @relation("Subtasks")
  comments     Comment[]
  attachments  Attachment[]
  labels       IssueLabel[]
  activities   IssueActivity[]
  sprintIssues SprintIssue[]
  outwardLinks IssueLink[]     @relation("OutwardIssue")
  inwardLinks  IssueLink[]     @relation("InwardIssue")
  watchers     IssueWatcher[]
  notifications Notification[]
  recentViews  RecentIssueView[]
  emailDeliveries EmailDelivery[]
  importRecord ImportedIssue?
  history IssueHistory[]
  releases IssueRelease[]
  customFieldValues CustomFieldValue[]
  developmentActivities DevelopmentActivity[]
  securityLevel IssueSecurityLevel? @relation(fields: [securityLevelId], references: [id], onDelete: Restrict)

  @@unique([projectId, number])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, assigneeId, statusId])
  @@index([projectId, statusId, rank])
  @@index([securityLevelId])
}

model DevelopmentConnection {
  id String @id @default(cuid())
  workspaceId String
  provider DevelopmentProvider
  name String
  baseUrl String
  encryptedCredential String
  encryptedWebhookSecret String
  credentialFingerprint String
  enabled Boolean @default(true)
  lastSyncedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  repositories DevelopmentRepository[]
  deliveries DevelopmentWebhookDelivery[]
  @@index([workspaceId, provider, enabled])
}
model DevelopmentRepository {
  id String @id @default(cuid())
  connectionId String
  externalId String
  fullName String
  webUrl String
  defaultBranch String?
  selected Boolean @default(true)
  accessible Boolean @default(true)
  lastSyncedAt DateTime?
  connection DevelopmentConnection @relation(fields:[connectionId], references:[id], onDelete:Cascade)
  activities DevelopmentActivity[]
  @@unique([connectionId, externalId])
  @@index([connectionId, selected])
}
model DevelopmentActivity {
  id String @id @default(cuid())
  repositoryId String
  issueId String
  externalId String
  kind DevelopmentActivityKind
  title String
  url String
  authorName String?
  targetBranch String?
  state String?
  reviewState String?
  buildState String?
  mergedAt DateTime?
  externalUpdatedAt DateTime
  payload Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repository DevelopmentRepository @relation(fields:[repositoryId], references:[id], onDelete:Restrict)
  issue Issue @relation(fields:[issueId], references:[id], onDelete:Cascade)
  @@unique([repositoryId, externalId, issueId])
  @@index([issueId, externalUpdatedAt])
}
model DevelopmentWebhookDelivery {
  id String @id @default(cuid())
  workspaceId String
  connectionId String
  deliveryId String
  event String
  receivedAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  connection DevelopmentConnection @relation(fields:[connectionId], references:[id], onDelete:Cascade)
  @@unique([connectionId, deliveryId])
  @@index([workspaceId, receivedAt])
}

model CustomField {
  id           String          @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  type         CustomFieldType
  options      Json?
  defaultValue Json?
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects     CustomFieldProject[]
  values       CustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archivedAt])
}

model CustomFieldProject {
  fieldId      String
  projectId    String
  required     Boolean     @default(false)
  issueTypeIds Json?
  position     Int         @default(0)
  field        CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([fieldId, projectId])
  @@index([projectId, position])
}

model CustomFieldValue {
  fieldId    String
  issueId    String
  workspaceId String
  projectId  String
  value      Json
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  field      CustomField @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  issue      Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([fieldId, issueId])
  @@index([workspaceId, projectId, fieldId])
  @@index([issueId])
}

model Release {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      ReleaseStatus @default(PLANNED)
  startsAt    DateTime?
  releaseDate DateTime?
  releasedAt  DateTime?
  archivedAt  DateTime?
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      IssueRelease[]

  @@unique([projectId, name])
  @@index([projectId, archivedAt, releaseDate])
}

model IssueRelease {
  releaseId String
  issueId   String
  addedAt   DateTime @default(now())
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([releaseId, issueId])
  @@index([issueId])
}

model IssueHistory {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  issueId        String
  sprintId       String?
  event          String
  statusCategory StatusCategory
  estimate       Int?
  occurredAt     DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue          Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@index([sprintId, occurredAt])
  @@index([issueId, occurredAt])
}

model IssueImport {
  id             String   @id @default(cuid())
  projectId      String
  idempotencyKey String
  rowCount       Int
  createdById    String
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
}

model ImportedIssue {
  projectId  String
  externalId String
  issueId    String @unique
  importId   String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([projectId, externalId])
  @@index([importId])
}

model EmailDelivery {
  id            String              @id @default(cuid())
  workspaceId   String?
  userId        String?
  issueId       String?
  category      String
  recipient     String
  subject       String
  textBody      String
  htmlBody      String
  dedupeKey     String              @unique
  correlationId String
  status        EmailDeliveryStatus @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now())
  lockedAt      DateTime?
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue         Issue?              @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([correlationId])
}

model Label {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  color       String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues      IssueLabel[]

  @@unique([workspaceId, name])
}

model IssueLabel {
  issueId String
  labelId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  issueId     String
  fileName    String
  objectKey   String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String?
  action    String
  changes   Json?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([issueId, createdAt])
}

model IssueLink {
  id             String @id @default(cuid())
  outwardIssueId String
  inwardIssueId  String
  type           String
  outwardIssue   Issue  @relation("OutwardIssue", fields: [outwardIssueId], references: [id], onDelete: Cascade)
  inwardIssue    Issue  @relation("InwardIssue", fields: [inwardIssueId], references: [id], onDelete: Cascade)

  @@unique([outwardIssueId, inwardIssueId, type])
  @@index([inwardIssueId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}

model Board {
  id        String        @id @default(cuid())
  projectId String
  name      String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
}

model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  statusId String
  name     String
  position Int
  wipLimit Int?
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status   Status @relation(fields: [statusId], references: [id])

  @@unique([boardId, statusId])
}

model Sprint {
  id                  String        @id @default(cuid())
  projectId           String
  name                String
  goal                String?
  state               SprintState   @default(PLANNED)
  startsAt            DateTime?
  endsAt              DateTime?
  completedAt         DateTime?
  totalIssueCount     Int?
  completedIssueCount Int?
  totalEstimate       Int?
  completedEstimate   Int?
  capacityTarget      Int?
  position            Int           @default(0)
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues              SprintIssue[]
  snapshotIssues      SprintSnapshotIssue[]

  @@index([projectId, state, position])
}

model SprintIssue {
  sprintId String
  issueId  String
  position Int
  addedAt  DateTime @default(now())
  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([sprintId, issueId])
  @@index([sprintId, position])
  @@index([issueId])
}

model SprintSnapshotIssue {
  sprintId    String
  issueId     String
  issueKey    String
  summary     String
  estimate    Int?
  completed   Boolean
  completedAt DateTime?
  sprint      Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@id([sprintId, issueId])
  @@index([sprintId, completed])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  issueId     String?
  actorId     String?
  type        NotificationType
  title       String
  resourceUrl String
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  dedupeKey   String           @unique
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issue       Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([issueId, createdAt])
}

model IssueWatcher {
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  query       Json
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ownerId, name])
  @@index([workspaceId, shared, updatedAt])
}

model RecentIssueView {
  userId     String
  issueId    String
  workspaceId String
  viewedAt   DateTime @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, issueId])
  @@index([workspaceId, userId, viewedAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ApiToken {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  prefix      String   @unique
  secretHash  String   @unique
  scopes      String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  idempotencyRecords ApiIdempotency[]

  @@index([workspaceId, revokedAt, createdAt])
}

model ApiIdempotency {
  tokenId    String
  key        String
  route      String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())
  token      ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, key, route])
  @@index([createdAt])
}

model WebhookSubscription {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  name            String
  url             String
  events          String[]
  secretHash      String
  encryptedSecret String
  enabled         Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([workspaceId, enabled])
  @@index([projectId])
}

model WebhookDelivery {
  id             String @id @default(cuid())
  subscriptionId String
  eventId        String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int @default(0)
  availableAt    DateTime @default(now())
  lockedAt       DateTime?
  deliveredAt    DateTime?
  responseStatus Int?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, availableAt])
  @@index([subscriptionId, createdAt])
}
