generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectVisibility {
  PUBLIC
  PRIVATE
}

enum IssueTypeKind {
  EPIC
  STORY
  TASK
  BUG
  SUBTASK
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum ProjectTemplate {
  KANBAN
  SCRUM
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum ReleaseStatus {
  PLANNED
  RELEASED
}

enum NotificationType {
  ASSIGNED
  MENTIONED
  COMMENTED
  ISSUE_UPDATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum EmailDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  DEAD
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String
  passwordHash   String?
  avatarUrl      String?
  timezone       String            @default("UTC")
  emailNotifications Boolean       @default(true)
  inAppNotifications Boolean       @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  memberships    WorkspaceMember[]
  projectRoles   ProjectMember[]
  reportedIssues Issue[]           @relation("Reporter")
  assignedIssues Issue[]           @relation("Assignee")
  comments       Comment[]
  activities     IssueActivity[]
  notifications  Notification[]  @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
  watchedIssues   IssueWatcher[]
  savedFilters    SavedFilter[]
  recentIssueViews RecentIssueView[]
  sessions       Session[]
  passwordResetTokens PasswordResetToken[]
  ledProjects    Project[]         @relation("ProjectLead")
  defaultProjects Project[]        @relation("ProjectDefaultAssignee")
  emailDeliveries EmailDelivery[]
  apiTokens ApiToken[]
}

model Workspace {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  memberships   WorkspaceMember[]
  projects      Project[]
  labels        Label[]
  notifications Notification[]
  recentViews RecentIssueView[]
  auditEvents   AuditEvent[]
  invitations   WorkspaceInvitation[]
  savedFilters  SavedFilter[]
  emailDeliveries EmailDelivery[]
  issueHistory IssueHistory[]
  apiTokens ApiToken[]
  webhookSubscriptions WebhookSubscription[]
}

model WorkspaceInvitation {
  id            String           @id @default(cuid())
  workspaceId   String
  projectId     String?
  email         String
  workspaceRole WorkspaceRole    @default(MEMBER)
  projectRole   ProjectRole      @default(MEMBER)
  status        InvitationStatus @default(PENDING)
  tokenHash     String           @unique
  invitedById   String
  expiresAt     DateTime
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([email, status])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  deactivatedAt DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id            String                @id @default(cuid())
  workspaceId   String
  name          String
  key           String
  description   String?
  visibility    ProjectVisibility     @default(PUBLIC)
  template      ProjectTemplate       @default(KANBAN)
  issueSequence Int                   @default(0)
  archivedAt    DateTime?
  leadId        String?
  defaultAssigneeId String?
  defaultPriority Priority             @default(MEDIUM)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       ProjectMember[]
  issueTypes    IssueType[]
  statuses      Status[]
  issues        Issue[]
  boards        Board[]
  sprints       Sprint[]
  invitations   WorkspaceInvitation[]
  workflowTransitions WorkflowTransition[]
  issueImports IssueImport[]
  importedIssues ImportedIssue[]
  issueHistory IssueHistory[]
  releases Release[]
  webhookSubscriptions WebhookSubscription[]
  lead          User?                 @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  defaultAssignee User?               @relation("ProjectDefaultAssignee", fields: [defaultAssigneeId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, key])
  @@index([workspaceId, archivedAt])
  @@index([leadId])
  @@index([defaultAssigneeId])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model IssueType {
  id        String        @id @default(cuid())
  projectId String
  name      String
  kind      IssueTypeKind
  icon      String?
  position  Int
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([projectId, name])
}

model Status {
  id        String         @id @default(cuid())
  projectId String
  name      String
  category  StatusCategory
  color     String
  position  Int
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues    Issue[]
  columns   BoardColumn[]
  outgoingTransitions WorkflowTransition[] @relation("TransitionFrom")
  incomingTransitions WorkflowTransition[] @relation("TransitionTo")

  @@unique([projectId, name])
}

model WorkflowTransition {
  id        String @id @default(cuid())
  projectId String
  fromStatusId String
  toStatusId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStatus Status @relation("TransitionFrom", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatus   Status @relation("TransitionTo", fields: [toStatusId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromStatusId, toStatusId])
  @@index([fromStatusId])
  @@index([toStatusId])
}

model Issue {
  id           String          @id @default(cuid())
  workspaceId  String
  projectId    String
  number       Int
  issueTypeId  String
  statusId     String
  reporterId   String
  assigneeId   String?
  parentId     String?
  summary      String
  description  Json?
  priority     Priority        @default(MEDIUM)
  estimate     Int?
  rank         String
  dueDate      DateTime?
  completedAt  DateTime?
  archivedAt   DateTime?
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issueType    IssueType       @relation(fields: [issueTypeId], references: [id])
  status       Status          @relation(fields: [statusId], references: [id])
  reporter     User            @relation("Reporter", fields: [reporterId], references: [id])
  assignee     User?           @relation("Assignee", fields: [assigneeId], references: [id])
  parent       Issue?          @relation("Subtasks", fields: [parentId], references: [id])
  subtasks     Issue[]         @relation("Subtasks")
  comments     Comment[]
  attachments  Attachment[]
  labels       IssueLabel[]
  activities   IssueActivity[]
  sprintIssues SprintIssue[]
  outwardLinks IssueLink[]     @relation("OutwardIssue")
  inwardLinks  IssueLink[]     @relation("InwardIssue")
  watchers     IssueWatcher[]
  notifications Notification[]
  recentViews  RecentIssueView[]
  emailDeliveries EmailDelivery[]
  importRecord ImportedIssue?
  history IssueHistory[]
  releases IssueRelease[]

  @@unique([projectId, number])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, assigneeId, statusId])
  @@index([projectId, statusId, rank])
}

model Release {
  id          String        @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      ReleaseStatus @default(PLANNED)
  startsAt    DateTime?
  releaseDate DateTime?
  releasedAt  DateTime?
  archivedAt  DateTime?
  version     Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues      IssueRelease[]

  @@unique([projectId, name])
  @@index([projectId, archivedAt, releaseDate])
}

model IssueRelease {
  releaseId String
  issueId   String
  addedAt   DateTime @default(now())
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([releaseId, issueId])
  @@index([issueId])
}

model IssueHistory {
  id             String   @id @default(cuid())
  workspaceId    String
  projectId      String
  issueId        String
  sprintId       String?
  event          String
  statusCategory StatusCategory
  estimate       Int?
  occurredAt     DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue          Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@index([sprintId, occurredAt])
  @@index([issueId, occurredAt])
}

model IssueImport {
  id             String   @id @default(cuid())
  projectId      String
  idempotencyKey String
  rowCount       Int
  createdById    String
  createdAt      DateTime @default(now())
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, createdAt])
}

model ImportedIssue {
  projectId  String
  externalId String
  issueId    String @unique
  importId   String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issue      Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([projectId, externalId])
  @@index([importId])
}

model EmailDelivery {
  id            String              @id @default(cuid())
  workspaceId   String?
  userId        String?
  issueId       String?
  category      String
  recipient     String
  subject       String
  textBody      String
  htmlBody      String
  dedupeKey     String              @unique
  correlationId String
  status        EmailDeliveryStatus @default(PENDING)
  attempts      Int                 @default(0)
  availableAt   DateTime            @default(now())
  lockedAt      DateTime?
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue         Issue?              @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([correlationId])
}

model Label {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  color       String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues      IssueLabel[]

  @@unique([workspaceId, name])
}

model IssueLabel {
  issueId String
  labelId String
  issue   Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
  @@index([labelId])
}

model Comment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  issue     Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@index([issueId, createdAt])
}

model Attachment {
  id          String   @id @default(cuid())
  issueId     String
  fileName    String
  objectKey   String   @unique
  contentType String
  size        Int
  createdAt   DateTime @default(now())
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model IssueActivity {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String?
  action    String
  changes   Json?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([issueId, createdAt])
}

model IssueLink {
  id             String @id @default(cuid())
  outwardIssueId String
  inwardIssueId  String
  type           String
  outwardIssue   Issue  @relation("OutwardIssue", fields: [outwardIssueId], references: [id], onDelete: Cascade)
  inwardIssue    Issue  @relation("InwardIssue", fields: [inwardIssueId], references: [id], onDelete: Cascade)

  @@unique([outwardIssueId, inwardIssueId, type])
  @@index([inwardIssueId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
  @@index([resetAt])
}

model Board {
  id        String        @id @default(cuid())
  projectId String
  name      String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]
}

model BoardColumn {
  id       String @id @default(cuid())
  boardId  String
  statusId String
  name     String
  position Int
  wipLimit Int?
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  status   Status @relation(fields: [statusId], references: [id])

  @@unique([boardId, statusId])
}

model Sprint {
  id                  String        @id @default(cuid())
  projectId           String
  name                String
  goal                String?
  state               SprintState   @default(PLANNED)
  startsAt            DateTime?
  endsAt              DateTime?
  completedAt         DateTime?
  totalIssueCount     Int?
  completedIssueCount Int?
  totalEstimate       Int?
  completedEstimate   Int?
  capacityTarget      Int?
  position            Int           @default(0)
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues              SprintIssue[]
  snapshotIssues      SprintSnapshotIssue[]

  @@index([projectId, state, position])
}

model SprintIssue {
  sprintId String
  issueId  String
  position Int
  addedAt  DateTime @default(now())
  sprint   Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  issue    Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([sprintId, issueId])
  @@index([sprintId, position])
  @@index([issueId])
}

model SprintSnapshotIssue {
  sprintId    String
  issueId     String
  issueKey    String
  summary     String
  estimate    Int?
  completed   Boolean
  completedAt DateTime?
  sprint      Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@id([sprintId, issueId])
  @@index([sprintId, completed])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  issueId     String?
  actorId     String?
  type        NotificationType
  title       String
  resourceUrl String
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  dedupeKey   String           @unique
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  issue       Issue?           @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([issueId, createdAt])
}

model IssueWatcher {
  issueId   String
  userId    String
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

model SavedFilter {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  query       Json
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, ownerId, name])
  @@index([workspaceId, shared, updatedAt])
}

model RecentIssueView {
  userId     String
  issueId    String
  workspaceId String
  viewedAt   DateTime @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issue      Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, issueId])
  @@index([workspaceId, userId, viewedAt])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ApiToken {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  prefix      String   @unique
  secretHash  String   @unique
  scopes      String[]
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  idempotencyRecords ApiIdempotency[]

  @@index([workspaceId, revokedAt, createdAt])
}

model ApiIdempotency {
  tokenId    String
  key        String
  route      String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())
  token      ApiToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@id([tokenId, key, route])
  @@index([createdAt])
}

model WebhookSubscription {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  name            String
  url             String
  events          String[]
  secretHash      String
  encryptedSecret String
  enabled         Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([workspaceId, enabled])
  @@index([projectId])
}

model WebhookDelivery {
  id             String @id @default(cuid())
  subscriptionId String
  eventId        String
  event          String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int @default(0)
  availableAt    DateTime @default(now())
  lockedAt       DateTime?
  deliveredAt    DateTime?
  responseStatus Int?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([status, availableAt])
  @@index([subscriptionId, createdAt])
}
